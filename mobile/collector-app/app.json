{
  "expo": {
    "name": "SmartRoute Driver",
    "slug": "smartroute-collector",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F6F5",
    "primaryColor": "#1E4E8C",
    "ios": {
      "bundleIdentifier": "in.smartroute.collector",
      "supportsTablet": false
    },
    "android": {
      "package": "in.smartroute.collector",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E4E8C"
      },
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SmartRoute uses your location to plan the pickup."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos of waste.",
          "cameraPermission": "Take photos of waste."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#132F57",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "serverUrl": "https://smartroute-api-8lxy.onrender.com",
      "eas": {
        "projectId": "93481802-1a4a-4511-836f-d09b8b8ab8c7"
      }
    }
  }
}

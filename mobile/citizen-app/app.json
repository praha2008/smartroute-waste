{
  "expo": {
    "name": "SmartRoute",
    "slug": "smartroute-citizen",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F6F5",
    "primaryColor": "#1B7F5A",
    "ios": {
      "bundleIdentifier": "in.smartroute.citizen",
      "supportsTablet": false
    },
    "android": {
      "package": "in.smartroute.citizen",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B7F5A"
      },
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SmartRoute uses your location to plan the pickup."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos of waste.",
          "cameraPermission": "Take photos of waste."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D5A3D",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "serverUrl": "https://smartroute-api-8lxy.onrender.com",
      "eas": {
        "projectId": "74875848-52fd-4bea-882d-22e21587c375"
      }
    }
  }
}

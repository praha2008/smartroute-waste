{
  "expo": {
    "name": "SmartRoute Recycle",
    "slug": "smartroute-recycler",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F6F5",
    "primaryColor": "#C16A00",
    "ios": {
      "bundleIdentifier": "in.smartroute.recycler",
      "supportsTablet": false
    },
    "android": {
      "package": "in.smartroute.recycler",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C16A00"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SmartRoute uses your location to plan the pickup."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos of waste.",
          "cameraPermission": "Take photos of waste."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "serverUrl": "https://smartroute-api-8lxy.onrender.com",
      "eas": {
        "projectId": "40a635d7-990e-4f7f-b100-ff3760910279"
      }
    }
  }
}
